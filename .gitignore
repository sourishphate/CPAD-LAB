# ==========================================
# Root .gitignore for CPAD-LAB Repository
# ==========================================

# Flutter & Dart dependencies and build outputs
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android build artifacts and caches
.gradle/
**/.gradle/
local.properties
**/local.properties
captures/
**/captures/
**/android/app/debug
**/android/app/profile
**/android/app/release
*.apk
*.aab
*.ap_
*.dex
*.class
key.properties
**/key.properties
*.keystore
**/*.keystore
*.jks
**/*.jks

# iOS & macOS artifacts & pods
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/DerivedData/
**/Pods/
**/.symlinks/
**/xcuserdata/
**/.generated/

# Windows & Linux desktop ephemeral builds
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
x64/
x86/
**/x64/
**/x86/
*.suo
*.user
*.userosscache
*.sln.docstates

# Node.js dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python environments & caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE & Editor files
.idea/
**/.idea/
*.iml
**/*.iml
*.ipr
*.iws
.vscode/
**/.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json
